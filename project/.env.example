# =============================================================================
# Newsletter (Resend) — copie para .env.local e preencha
# =============================================================================

# Chave de API do Resend
RESEND_API_KEY=

# ID da audience do Resend (com unsubscribe configurado)
RESEND_AUDIENCE_ID=

# Segredo HMAC do token de double opt-in. Gere com: openssl rand -hex 32
NEWSLETTER_SIGNING_SECRET=

# Remetente. Exige domínio/subdomínio verificado no Resend.
# A Soliê não tem caixa monitorada: use um subdomínio de envio.
NEWSLETTER_FROM="Soliê <novidades@news.soliepilates.com.br>"

# Base URL para montar o link de confirmação.
# Local: http://localhost:3000
# Produção: pode deixar vazio (usa https://soliepilates.com.br como fallback).
SITE_URL=http://localhost:3000

NEXT_PUBLIC_TURNSTILE_SITE_KEY=

TURNSTILE_SECRET_KEY=
